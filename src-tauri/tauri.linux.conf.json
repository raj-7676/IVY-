{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "mainBinaryName": "ivy",
  "build": {
    "beforeBundleCommand": {
      "script": "cargo build --release --locked --manifest-path linux/ivy-keys/Cargo.toml --target-dir target",
      "cwd": "."
    }
  },
  "bundle": {
    "targets": ["deb", "rpm"],
    "category": "Utility",
    "shortDescription": "Offline voice dictation",
    "longDescription": "Hold a key, talk, let go: Ivy types what you meant into any app. Its speech model runs on your own computer; nothing you say leaves it. On Wayland desktops Ivy's small keyboard helper (/usr/libexec/ivy-keys) may read the keyboard and press paste, through the input group.",
    "linux": {
      "deb": {
        "depends": ["libvulkan1", "libasound2t64 | libasound2"],
        "recommends": ["gstreamer1.0-plugins-good", "gstreamer1.0-libav", "pkexec | policykit-1"],
        "files": {
          "/usr/libexec/ivy-keys": "target/release/ivy-keys",
          "/usr/libexec/ivy-keys-setup": "linux/ivy-keys-setup",
          "/usr/lib/udev/rules.d/60-ivy-keys.rules": "linux/60-ivy-keys.rules"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      },
      "rpm": {
        "depends": ["libayatana-appindicator-gtk3", "vulkan-loader", "alsa-lib"],
        "recommends": ["gstreamer1-plugins-good", "gstreamer1-plugin-openh264"],
        "files": {
          "/usr/libexec/ivy-keys": "target/release/ivy-keys",
          "/usr/libexec/ivy-keys-setup": "linux/ivy-keys-setup",
          "/usr/lib/udev/rules.d/60-ivy-keys.rules": "linux/60-ivy-keys.rules"
        },
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      }
    }
  }
}
