{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ivy",
  "version": "0.1.0",
  "identifier": "app.ivy.dictation",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ivy",
        "width": 1120,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data: blob:; font-src 'self' data:; media-src 'self' asset: https://asset.localhost blob:; connect-src 'self' asset: https://asset.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none';",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/audio/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "models/whisper/**/*": "models/whisper/"
    },
    "windows": {
      "nsis": {
        "installerHooks": "installer/hooks.nsh"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
